# A native example of the supported PBRT v4 subset, not a gallery reference.
LookAt 0 1.6 -5  0 0.2 0  0 1 0
Camera "perspective" "float fov" 45
Film "rgb" "integer xresolution" 512 "integer yresolution" 384
Sampler "independent" "integer pixelsamples" 64 "integer seed" 123
Integrator "path" "integer maxdepth" 8
PixelFilter "box"

WorldBegin
MakeNamedMaterial "floor" "string type" "diffuse" "rgb reflectance" [0.6 0.6 0.6]
AttributeBegin
    NamedMaterial "floor"
    Shape "trianglemesh" "integer indices" [0 1 2 0 2 3]
        "point3 P" [-3 -0.5 -2  -3 -0.5 3  3 -0.5 3  3 -0.5 -2]
AttributeEnd
AttributeBegin
    Material "diffuse" "rgb reflectance" [0.6 0.1 0.05]
    Translate -1 0 0
    Shape "sphere" "float radius" 0.5
AttributeEnd
AttributeBegin
    Material "dielectric" "float eta" 1.5
    Shape "sphere" "float radius" 0.5
AttributeEnd
AttributeBegin
    Material "conductor" "rgb eta" [0.2 0.9 1.1] "rgb k" [3.9 2.45 2.14]
        "float roughness" 0.04 "bool remaproughness" true
    Translate 1 0 0
    Shape "sphere" "float radius" 0.5
AttributeEnd
AttributeBegin
    AreaLightSource "diffuse" "rgb L" [8 8 8]
    Shape "trianglemesh" "integer indices" [0 1 2 0 2 3]
        "point3 P" [-1 3 -1  1 3 -1  1 3 1  -1 3 1]
AttributeEnd
